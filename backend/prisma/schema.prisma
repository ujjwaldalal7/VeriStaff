generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  INVITED
  ONBOARDING
  ACTIVE
  RESIGNED
  OFFBOARDED
}

enum DocType {
  OFFER_LETTER
  PAYSLIP
  RELIEVING_LETTER
  EXPERIENCE_LETTER
}

enum ClearanceDept {
  IT
  FINANCE
  HR
}

enum ClearanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentStatus {
  VALID
  REVOKED
}

enum AuditAction {
  LOGIN
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMPLOYEE_CREATE
  EMPLOYEE_UPDATE
  EMPLOYEE_RESIGN
  CLEARANCE_UPDATE
  DOCUMENT_CREATE
  DOCUMENT_DOWNLOAD
  DOCUMENT_REVOKE
  DOCUMENT_DELETE
  DOCUMENT_VIEW
  USER_CREATE
  USER_ROLE_CHANGE
  USER_DISABLE
  USER_ENABLE
  ONBOARDING_INVITE
  ONBOARDING_COMPLETE
  BRANDING_UPDATE
  MANAGER_ASSIGNMENT
}

model Tenant {
  id                String              @id @default(uuid())
  name              String
  domain            String              @unique
  logoUrl           String?
  watermarkUrl      String?
  primaryColor      String              @default("#1E40AF")
  secondaryColor    String              @default("#3B82F6")
  footerAddress     String              @default("")
  authorizedSignUrl String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  users             User[]
  employees         Employee[]
  documents         GeneratedDocument[]
  onboardingInvites OnboardingInvite[]
  auditLogs AuditLog[]
}

model User {
  id             String                @id @default(uuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String                @unique
  passwordHash   String
  role           Role                  @default(EMPLOYEE)
  isActive       Boolean               @default(true)
  tokenVersion   Int                   @default(0)
  firstName      String?
  lastName       String?
  employee       Employee?
  managedEmployees ManagerAssignment[] @relation("ManagerAssignments")
  clearancesDone DepartmentClearance[] @relation("ClearedBy")
  auditLogs AuditLog[]
  revokedDocuments GeneratedDocument[] @relation("RevokedBy")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([tenantId])
}

model Employee {
  id              String                @id @default(uuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String?               @unique
  user            User?                 @relation(fields: [userId], references: [id])
  employeeCode    String
  email           String?
  firstName       String
  lastName        String
  department      String
  designation     String
  joiningDate     DateTime
  resignationDate DateTime?
  lastWorkingDay  DateTime?
  status          EmployeeStatus        @default(INVITED)
  basicSalary     Decimal               @default(0) @db.Decimal(12, 2)
  hra             Decimal               @default(0) @db.Decimal(12, 2)
  allowances      Decimal               @default(0) @db.Decimal(12, 2)
  deductions      Decimal               @default(0) @db.Decimal(12, 2)
  bankAccountNo   String?
  bankIfsc        String?
  panCard         String?
  nationalIdUrl   String?
  documents       GeneratedDocument[]
  clearances      DepartmentClearance[]
  payslips        Payslip[]
  managerAssignments ManagerAssignment[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

model ManagerAssignment {
  id         String   @id @default(uuid())
  managerId  String
  employeeId String
  manager    User     @relation("ManagerAssignments", fields: [managerId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([managerId, employeeId])
  @@index([managerId])
  @@index([employeeId])
}

model Payslip {
  id String @id @default(uuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  month Int
  year  Int

  basicSalary Decimal @db.Decimal(12, 2)
  hra         Decimal @db.Decimal(12, 2)
  allowances  Decimal @db.Decimal(12, 2)
  deductions  Decimal @db.Decimal(12, 2)

  grossSalary Decimal @db.Decimal(12, 2)
  netSalary   Decimal @db.Decimal(12, 2)

  generatedDocumentId String?            @unique
  generatedDocument   GeneratedDocument? @relation(fields: [generatedDocumentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
}

model OnboardingInvite {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  token      String   @unique
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  employeeId String?
  createdAt  DateTime @default(now())

  @@index([tenantId, email])
  @@index([token])
}

model GeneratedDocument {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  docNumber String  @unique
  docType   DocType

  verificationHash String  @unique
  pdfUrl           String?
  metadataJson     Json

  status           DocumentStatus @default(VALID)
  revokedAt        DateTime?
  revokedById      String?
  revokedBy        User?          @relation("RevokedBy", fields: [revokedById], references: [id])

  payslip Payslip?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@index([verificationHash])
  @@index([status])
}

model DepartmentClearance {
  id          String          @id @default(uuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department  ClearanceDept
  status      ClearanceStatus @default(PENDING)
  remarks     String?
  clearedBy   User?           @relation("ClearedBy", fields: [clearedById], references: [id])
  clearedById String?
  clearedAt   DateTime?

  @@unique([employeeId, department])
  @@index([employeeId])
}


model AuditLog {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action AuditAction

  entityType String
  entityId   String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([entityType, entityId])
  @@index([actorId])
}
